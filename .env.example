R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

WEBFLOW_API_KEY=
WEBFLOW_COLLECTION_ID=

NEON_DATABASE_URL=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
ASSEMBLYAI_API_KEY=

# Memberstack 2.0 Admin API secret key (Dashboard → Dev Tools → Keys & IDs).
# Server-side only — never expose. sk_… = live, sk_sb_… = test (test capped at 50 members).
MEMBERSTACK_SECRET_KEY=
# Optional: your Memberstack app id (app_…). When set, member JWTs are verified
# with an audience check for extra hardening. Safe to leave blank.
NEXT_PUBLIC_MEMBERSTACK_APP_ID=
# Memberstack public/DOM key (pk_… live, pk_sb_… test) — Dashboard → Dev Tools → Keys.
# Distinct from the app id above. NEXT_PUBLIC_ → baked in at build time; public by design.
# Currently UNUSED by the app: creating a client sends no email of any kind (the Admin API
# has no method to send one). New members get in via the "Copy login link" button.
NEXT_PUBLIC_MEMBERSTACK_PUBLIC_KEY=
# The FREE Memberstack plan id (pln_…) attached to every new client — the "individual"
# plan. Dashboard → Plans → the plan → copy its id. Only free plans (pln_) attach on
# create. Leave blank to attach no plan.
MEMBERSTACK_INDIVIDUAL_PLAN_ID=
# The FREE Memberstack plan id (pln_…) for cohort members. REQUIRED in any environment
# running cohorts: the portal gates its cohort panel on this plan, so leaving it blank
# creates members who can log in but see only the upsell. /reconcile also refuses to run
# without it, since every member would read as unentitled and the check would look clean.
MEMBERSTACK_COHORT_PLAN_ID=

UPLOAD_TOOL_PASSWORD=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=

# Set to "true" once the app is served over HTTPS (real domain). Leave unset/false
# when testing over the bare droplet IP on plain HTTP, or the login cookie is dropped.
COOKIE_SECURE=

# Global booking link Lindsay reuses for everyone. Shown as a "copy booking link"
# button on the client view. NEXT_PUBLIC_ → baked in at build time (rebuild to change).
NEXT_PUBLIC_BOOKING_URL=
# Webflow passwordless login page (e.g. https://www.showyourspark.com/login). Powers the
# per-client "Copy login link" button; the copied link is suffixed with ?email=<client>
# so the login form can pre-fill their email. The cohort roster copies it unsuffixed,
# which is the version to paste in a group chat. NEXT_PUBLIC_ → baked in at build time.
NEXT_PUBLIC_PORTAL_LOGIN_URL=
# The portal itself (e.g. https://www.showyourspark.com/portal) — the link for members who
# already have an account. Loading the login page above clears an existing session, so
# anyone who bookmarks THAT one is asked for a fresh code every visit; this one lands them
# straight in. NEXT_PUBLIC_ → baked in at build time.
NEXT_PUBLIC_PORTAL_URL=
